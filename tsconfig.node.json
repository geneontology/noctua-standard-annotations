{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "tests/fixtures/terms.ts",
    "src/@noctua.core/models/relations.ts",
    "src/features/gocam/models/cam.ts",
    "src/features/users/models/contributor.ts"
  ]
}
