{
  "name": "@geneontology/noctua-standard-annotations",
  "private": false,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --mode development --host 0.0.0.0 --port 4203",
    "start:development": "vite --mode development --host 0.0.0.0 --port 4203",
    "start:staging": "vite --mode staging --host 0.0.0.0 --port 4203",
    "start:production": "vite --mode production --host 0.0.0.0 --port 4203",
    "clean": "node -e \"for (const d of ['workbenches/noctua-standard-annotations/public','workbenches/noctua-standard-annotations-beta/public']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "build": "npm run type-check && vite build --mode production",
    "build:dev": "npm run type-check && vite build --mode development",
    "build:beta-test": "npm run type-check && vite build --mode staging",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@mantine/core": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@mantine/notifications": "^9.1.1",
    "@reduxjs/toolkit": "^2.6.1",
    "@tailwindcss/vite": "^4.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^7.1.5",
    "uuid": "^11.1.0",
    "vite-plugin-checker": "^0.14.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^23.2.0",
    "prettier": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.5",
    "vitest": "^3.1.1"
  }
}
